class Solution {
public:
    int evalRPN(vector<string>& tokens) {
        stack<int>number;
        int n=tokens.size();
        for(int i=0;i<n;i++){
            if(tokens[i]!="+"&&tokens[i]!="-"&&tokens[i]!="*"&&tokens[i]!="/"){
                number.push(stoi(tokens[i]));
            }
            else if(tokens[i]=="+"){
                int first = number.top();
                number.pop();
                int  second=number.top();
                number.pop();

                number.push(first+second);
            }
            else if(tokens[i]=="-"){
                int first = number.top();
                number.pop();
                int  second=number.top();
                number.pop();

                number.push(second-first);
            }
            else if(tokens[i]=="*"){
                int first = number.top();
                number.pop();
                int  second=number.top();
                number.pop();

                number.push(first*second);
            }
            else if(tokens[i]=="/"){
                int first = number.top();
                number.pop();
                int  second=number.top();
                number.pop();

                number.push(second/first);
            }
        }
        return number.top();
    }
};