class MinStack {
public:
    stack<int>st;
    stack<int>MinSt;
    MinStack() {
    }
    
    void push(int value) {
        st.push(value);
        if(MinSt.empty()||MinSt.top()>=value){
            MinSt.push(value);
        }
        
    }
    
    void pop() {
        int ele=st.top();
        st.pop();
        if(MinSt.top()==ele){
            MinSt.pop();
        }
    }
    
    int top() {
        return st.top();
    }
    
    int getMin() {
        return MinSt.top();
    }
};

