class Solution {
public:
    string reverseWords(string s) {
        int n=s.size();
        int i=0;
        string ans="";
        while(i<n){
            string temp="";
            while(i<n && s[i]!=' '){
                temp+=s[i];
                i++;
            }
            reverse(temp.begin(),temp.end());
            ans+=temp;
            if(i<n){
                ans+=' ';
                i++;
            }
        }
        return ans;
    }
};