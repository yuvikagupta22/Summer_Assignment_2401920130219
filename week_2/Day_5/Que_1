class Solution {
public:
    vector<vector<string>> groupAnagrams(vector<string>& strs) {
        unordered_map<string,vector<string>>anagram;
        for(string s:strs){
            string t=s;
            sort(t.begin(),t.end());
            anagram[t].push_back(s);
        }
        vector<vector<string>>ans;
        for(auto a :anagram){
            ans.push_back(a.second);
        }
        return ans ;
    }
};