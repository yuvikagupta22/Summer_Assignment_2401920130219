class Solution {
public:
    vector<int> twoSum(vector<int>& nums, int target) {
        int i ,j;
        int s=nums.size();
        for(i=0;i<s;i++){
            for(j=i+1;j<s;j++){
                int c=nums[i]+nums[j];
                if(c==target){
                    return{i,j};
                }
            }
        }
        return{};
    }
};