QUE- https://leetcode.com/problems/asteroid-collision/description/

class Solution {
public:
    vector<int> asteroidCollision(vector<int>& astroids) {
        stack<int>st;
        int len=astroids.size();
        for(int i=0;i<len;i++){
            if(astroids[i]>0){
                st.push(astroids[i]);
            }
            else{
                while(!st.empty()&& st.top()>0&& st.top()<abs(astroids[i])){
                    st.pop();
                }
                if(!st.empty() && st.top()==abs(astroids[i])){
                    st.pop();
                }
                else {
                    if(st.empty()||st.top()<0){
                        st.push(astroids[i]);
                    }
                }
            }
        }
        vector<int>ans(st.size());
        for(int i=st.size()-1;i>=0;i--){
            ans[i]=st.top();
            st.pop();
        }
        return ans;
    }
};