APPROACH 1->

/**
 * Definition for singly-linked list.
 * struct ListNode {
 *     int val;
 *     ListNode *next;
 *     ListNode() : val(0), next(nullptr) {}
 *     ListNode(int x) : val(x), next(nullptr) {}
 *     ListNode(int x, ListNode *next) : val(x), next(next) {}
 * };
 */
class Solution {
public:
    bool isPalindrome(ListNode* head) {
        ListNode* temp1=head;
        stack<ListNode*>st;
        while(temp1!=NULL){
            st.push(temp1);
            temp1=temp1->next;
        }
        ListNode* temp2=head;
        bool isPalindrome=true;
        while(!st.empty()){
            if(st.top()->val==temp2->val){
                temp2=temp2->next;
                st.pop();
            }
            else{
                isPalindrome=false;
                break;
            }
        }
        if(isPalindrome){
            return true;
        }
        else{
            return false;
        }
    }
};

